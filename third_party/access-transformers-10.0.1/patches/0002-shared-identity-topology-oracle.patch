+    private static void assertSemanticSurfaces(StockReference stock, AccessTransformerList candidate, Type type) {
+        assertEquals(stock.accessTransformerGroups().stream().sorted().toList(), orderedGroups(candidate.getAccessTransformers()).stream().sorted().toList());
+        assertEquals(stock.transformersFor(type).stream().sorted().toList(), orderedTargetGroups(candidate.getTransformersForTarget(type)).stream().sorted().toList());
+        assertEquals(Set.copyOf(stock.targets()), Set.copyOf(candidate.getTargets()));
+    }
