+    @SuppressWarnings("unchecked")
+    private static Map<Target<?>, AccessTransformer> rawMap(AccessTransformerList list) {
+        try {
+            var field = AccessTransformerList.class.getDeclaredField("accessTransformers");
+            field.setAccessible(true);
+            return (Map<Target<?>, AccessTransformer>) field.get(list);
+        } catch (ReflectiveOperationException e) {
+            throw new AssertionError(e);
+        }
+    }
+
+    private static int originLine(AccessTransformer at, String origin) {
+        String prefix = origin + ":";
+        return at.getOrigins().stream().filter(o -> o.startsWith(prefix)).mapToInt(o -> Integer.parseInt(o.substring(prefix.length()))).min().orElseThrow();
+    }
+
+    private static List<String> orderedEntries(Map<Target<?>, AccessTransformer> raw) {
+        return raw.entrySet().stream().map(e -> e.getKey() + "=" + e.getValue()).toList();
+    }
+
+    private static Map<String, List<AccessTransformer>> groupsFromRaw(Map<Target<?>, AccessTransformer> raw) {
+        return raw.values().stream().collect(Collectors.groupingBy(
+                at -> at.getTarget().getClassName(), HashMap::new, Collectors.toList()));
+    }
+
+    private static Map<TargetType, Map<String, AccessTransformer>> groupsForTarget(Map<Target<?>, AccessTransformer> raw, Type type) {
+        return raw.entrySet().stream()
+                .filter(e -> type.equals(e.getKey().getASMType()))
+                .map(Map.Entry::getValue)
+                .collect(Collectors.groupingBy(o -> o.getTarget().getType(), HashMap::new,
+                        Collectors.toMap(at -> at.getTarget().targetName(), java.util.function.Function.identity())));
     }
