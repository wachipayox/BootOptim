diff --git a/src/test/java/net/neoforged/accesstransformer/parser/IncrementalAccessTransformerListTest.java b/src/test/java/net/neoforged/accesstransformer/parser/IncrementalAccessTransformerListTest.java
new file mode 100644
index 0000000..88d50f0
--- /dev/null
+++ b/src/test/java/net/neoforged/accesstransformer/parser/IncrementalAccessTransformerListTest.java
@@ -0,0 +1,153 @@
+package net.neoforged.accesstransformer.parser;
+
+import net.neoforged.accesstransformer.AccessTransformer;
+import net.neoforged.accesstransformer.Target;
+import net.neoforged.accesstransformer.generated.AtLexer;
+import net.neoforged.accesstransformer.generated.AtParser;
+import org.antlr.v4.runtime.CharStream;
+import org.antlr.v4.runtime.CharStreams;
+import org.antlr.v4.runtime.CommonTokenStream;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.Type;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeMap;
+import java.util.stream.Collectors;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class IncrementalAccessTransformerListTest {
+    @Test
+    void sequentialFilesMatchStockStateOriginsInnerTargetsAndTargets() {
+        var candidate = new AccessTransformerList();
+        var reference = new StockReference();
+
+        loadBoth(candidate, reference, """
+                public-f example.Alpha
+                protected example.Alpha field
+                public example.Outer$Inner
+                """, "first.cfg");
+        loadBoth(candidate, reference, """
+                public example.Alpha field
+                protected example.Bravo method()V
+                public example.Alpha other
+                """, "second.cfg");
+
+        assertEquivalent(reference, candidate);
+    }
+
+    @Test
+    void finalConflictRollsBackWholeFile() {
+        var candidate = new AccessTransformerList();
+        var reference = new StockReference();
+        loadBoth(candidate, reference, "public-f example.Alpha\n", "first.cfg");
+
+        var candidateBefore = snapshot(candidate);
+        var referenceBefore = reference.snapshot();
+        var candidateTargetsBefore = Set.copyOf(candidate.getTargets());
+        var referenceTargetsBefore = Set.copyOf(reference.targets);
+
+        var candidateFailure = assertThrows(IllegalArgumentException.class,
+                () -> load(candidate, "public+f example.Alpha\npublic example.NewTarget\n", "conflict.cfg"));
+        var referenceFailure = assertThrows(IllegalArgumentException.class,
+                () -> reference.load("public+f example.Alpha\npublic example.NewTarget\n", "conflict.cfg"));
+
+        assertEquals(referenceFailure.getMessage(), candidateFailure.getMessage());
+        assertEquals(referenceBefore, reference.snapshot());
+        assertEquals(candidateBefore, snapshot(candidate));
+        assertEquals(referenceTargetsBefore, reference.targets);
+        assertEquals(candidateTargetsBefore, candidate.getTargets());
+        assertFalse(candidate.getTargets().contains(Type.getObjectType("example/NewTarget")));
+    }
+
+    @Test
+    void malformedFileKeepsPreviousTransactionAndParserFailure() {
+        var candidate = new AccessTransformerList();
+        var reference = new StockReference();
+        loadBoth(candidate, reference, "public example.Alpha\n", "first.cfg");
+        var candidateBefore = snapshot(candidate);
+        var referenceBefore = reference.snapshot();
+        var malformed = "public example.Bravo\npublic example.Bad method(\n";
+
+        var candidateFailure = assertThrows(RuntimeException.class,
+                () -> load(candidate, malformed, "malformed.cfg"));
+        var referenceFailure = assertThrows(RuntimeException.class,
+                () -> reference.load(malformed, "malformed.cfg"));
+
+        assertEquals(referenceFailure.getClass(), candidateFailure.getClass());
+        assertEquals(referenceFailure.getMessage(), candidateFailure.getMessage());
+        assertEquals(referenceBefore, reference.snapshot());
+        assertEquals(candidateBefore, snapshot(candidate));
+    }
+
+    @Test
+    void escapedMutableTargetSetIsDetachedAndMutationDiscardedOnNextCommit() {
+        var candidate = new AccessTransformerList();
+        var reference = new StockReference();
+        loadBoth(candidate, reference, "public example.Alpha\n", "first.cfg");
+
+        var escapedCandidate = candidate.getTargets();
+        var escapedReference = reference.targets;
+        var mutation = Type.getObjectType("external/Mutation");
+        escapedCandidate.add(mutation);
+        escapedReference.add(mutation);
+        assertTrue(candidate.containsClassTarget(mutation));
+
+        loadBoth(candidate, reference, "public example.Bravo\n", "second.cfg");
+        assertTrue(escapedCandidate.contains(mutation));
+        assertTrue(escapedReference.contains(mutation));
+        assertFalse(candidate.getTargets().contains(mutation));
+        assertFalse(reference.targets.contains(mutation));
+        assertEquivalent(reference, candidate);
+    }
+
+    private static void loadBoth(AccessTransformerList candidate, StockReference reference, String text, String origin) {
+        load(candidate, text, origin);
+        reference.load(text, origin);
+        assertEquivalent(reference, candidate);
+    }
+
+    private static void load(AccessTransformerList candidate, String text, String origin) {
+        candidate.loadAT(CharStreams.fromString(text, origin));
+    }
+
+    private static void assertEquivalent(StockReference reference, AccessTransformerList candidate) {
+        assertEquals(reference.snapshot(), snapshot(candidate));
+        assertEquals(reference.targets, candidate.getTargets());
+    }
+
+    private static Map<String, String> snapshot(AccessTransformerList candidate) {
+        var result = new TreeMap<String, String>();
+        candidate.getAccessTransformers().values().stream().flatMap(List::stream)
+                .forEach(at -> result.put(at.getTarget().toString(), at.toString()));
+        return result;
+    }
+
+    private static final class StockReference {
+        private final Map<Target<?>, AccessTransformer> accessTransformers = new HashMap<>();
+        private Set<Type> targets = Collections.emptySet();
+
+        private void load(String text, String origin) {
+            CharStream stream = CharStreams.fromString(text, origin);
+            var parser = new AtParser(new CommonTokenStream(new AtLexer(stream)));
+            parser.addErrorListener(new AtParserErrorListener());
+            var visitor = new AccessTransformVisitor(stream.getSourceName());
+            parser.file().accept(visitor);
+            var local = new HashMap<>(accessTransformers);
+            visitor.getAccessTransformers().forEach(at -> local.merge(at.getTarget(), at,
+                    (left, right) -> left.mergeStates(right, stream.getSourceName())));
+            List<AccessTransformer> invalid = local.values().stream().filter(at -> !at.isValid()).collect(Collectors.toList());
+            if (!invalid.isEmpty()) {
+                throw new IllegalArgumentException("Invalid AT final conflicts");
+            }
+            accessTransformers.clear();
+            accessTransformers.putAll(local);
+            targets = accessTransformers.keySet().stream().map(Target::getASMType).collect(Collectors.toSet());
+        }
+
+        private Map<String, String> snapshot() {
+            var result = new TreeMap<String, String>();
+            accessTransformers.values().forEach(at -> result.put(at.getTarget().toString(), at.toString()));
+            return result;
+        }
+    }
+}