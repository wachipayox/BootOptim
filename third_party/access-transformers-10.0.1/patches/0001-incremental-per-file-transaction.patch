diff --git a/src/test/java/net/neoforged/accesstransformer/IncrementalAccessTransformerFilesTest.java b/src/test/java/net/neoforged/accesstransformer/IncrementalAccessTransformerFilesTest.java
new file mode 100644
index 0000000..c20a181
--- /dev/null
+++ b/src/test/java/net/neoforged/accesstransformer/IncrementalAccessTransformerFilesTest.java
@@ -0,0 +1,153 @@
+package net.neoforged.accesstransformer;
+
+import net.neoforged.accesstransformer.parser.AccessTransformerFiles;
+import net.neoforged.accesstransformer.parser.AtParser;
+import net.neoforged.accesstransformer.parser.Target;
+import net.neoforged.accesstransformer.parser.Transformation;
+import org.junit.jupiter.api.Test;
+
+import java.io.IOException;
+import java.io.Reader;
+import java.io.StringReader;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Set;
+import java.util.stream.Collectors;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class IncrementalAccessTransformerFilesTest {
+    @Test
+    void sequentialFilesPreserveMergedStateOriginsAndTargets() throws Exception {
+        var candidate = new AccessTransformerFiles();
+        var reference = new StockReference();
+
+        loadBoth(candidate, reference, """
+                public-f example.Alpha
+                protected example.Alpha field
+                public example.Outer$Inner
+                """, "first.cfg");
+        loadBoth(candidate, reference, """
+                public example.Alpha field
+                protected example.Bravo method()V
+                public example.Alpha other
+                """, "second.cfg");
+
+        assertEquivalent(reference, candidate);
+    }
+
+    @Test
+    void finalConflictRollsBackTheWholeFile() throws Exception {
+        var candidate = new AccessTransformerFiles();
+        var reference = new StockReference();
+        loadBoth(candidate, reference, "public-f example.Alpha\n", "first.cfg");
+
+        var candidateBefore = snapshot(candidate.getAccessTransformers());
+        var candidateTargetsBefore = Set.copyOf(candidate.getTargets());
+        var referenceBefore = snapshot(reference.accessTransformers);
+        var referenceTargetsBefore = Set.copyOf(reference.targets);
+
+        var candidateFailure = assertThrows(IllegalArgumentException.class,
+                () -> candidate.loadAT(new StringReader("public+f example.Alpha\npublic example.NewTarget\n"), "conflict.cfg"));
+        var referenceFailure = assertThrows(IllegalArgumentException.class,
+                () -> reference.loadAT(new StringReader("public+f example.Alpha\npublic example.NewTarget\n"), "conflict.cfg"));
+
+        assertEquals(referenceFailure.getMessage(), candidateFailure.getMessage());
+        assertEquals(referenceBefore, snapshot(reference.accessTransformers));
+        assertEquals(candidateBefore, snapshot(candidate.getAccessTransformers()));
+        assertEquals(referenceTargetsBefore, reference.targets);
+        assertEquals(candidateTargetsBefore, candidate.getTargets());
+        assertFalse(candidate.getTargets().contains("example.NewTarget"));
+    }
+
+    @Test
+    void malformedFileKeepsPreviousTransactionAndExactParserFailure() throws Exception {
+        var candidate = new AccessTransformerFiles();
+        var reference = new StockReference();
+        loadBoth(candidate, reference, "public example.Alpha\n", "first.cfg");
+
+        var candidateBefore = snapshot(candidate.getAccessTransformers());
+        var referenceBefore = snapshot(reference.accessTransformers);
+        var malformed = "public example.Bravo\nnot-a-modifier example.Bad\n";
+
+        var candidateFailure = assertThrows(RuntimeException.class,
+                () -> candidate.loadAT(new StringReader(malformed), "malformed.cfg"));
+        var referenceFailure = assertThrows(RuntimeException.class,
+                () -> reference.loadAT(new StringReader(malformed), "malformed.cfg"));
+
+        assertEquals(referenceFailure.getClass(), candidateFailure.getClass());
+        assertEquals(referenceFailure.getMessage(), candidateFailure.getMessage());
+        assertEquals(referenceBefore, snapshot(reference.accessTransformers));
+        assertEquals(candidateBefore, snapshot(candidate.getAccessTransformers()));
+    }
+
+    @Test
+    void exposedMutableTargetSetIsDetachedAndCallerMutationIsDiscardedOnCommit() throws Exception {
+        var candidate = new AccessTransformerFiles();
+        var reference = new StockReference();
+        loadBoth(candidate, reference, "public example.Alpha\n", "first.cfg");
+
+        var escapedCandidate = candidate.getTargets();
+        var escapedReference = reference.targets;
+        escapedCandidate.add("external.Mutation");
+        escapedReference.add("external.Mutation");
+        assertTrue(candidate.containsClassTarget("external.Mutation"));
+
+        loadBoth(candidate, reference, "public example.Bravo\n", "second.cfg");
+
+        assertTrue(escapedCandidate.contains("external.Mutation"));
+        assertTrue(escapedReference.contains("external.Mutation"));
+        assertFalse(candidate.getTargets().contains("external.Mutation"));
+        assertFalse(reference.targets.contains("external.Mutation"));
+        assertEquivalent(reference, candidate);
+    }
+
+    private static void loadBoth(AccessTransformerFiles candidate, StockReference reference, String text, String origin) throws Exception {
+        candidate.loadAT(new StringReader(text), origin);
+        reference.loadAT(new StringReader(text), origin);
+        assertEquivalent(reference, candidate);
+    }
+
+    private static void assertEquivalent(StockReference reference, AccessTransformerFiles candidate) {
+        assertEquals(snapshot(reference.accessTransformers), snapshot(candidate.getAccessTransformers()));
+        assertEquals(reference.targets, candidate.getTargets());
+    }
+
+    private static Map<Target, String> snapshot(Map<Target, Transformation> source) {
+        var snapshot = new HashMap<Target, String>();
+        source.forEach((target, transformation) -> snapshot.put(target,
+                transformation.modifier() + "/" + transformation.finalState() + "/" + transformation.origins()));
+        return snapshot;
+    }
+
+    private static final class StockReference {
+        private final Map<Target, Transformation> accessTransformers = new HashMap<>();
+        private Set<String> targets = Collections.emptySet();
+
+        private void loadAT(Reader reader, String origin) throws IOException {
+            var localATCopy = new HashMap<>(accessTransformers);
+            AtParser.parse(reader, origin, (target, transformation) ->
+                    localATCopy.merge(target, transformation, Transformation::mergeStates));
+            if (localATCopy.values().stream().anyMatch(transformation -> !transformation.isValid())) {
+                throw new IllegalArgumentException("Invalid AT final conflicts");
+            }
+            accessTransformers.clear();
+            accessTransformers.putAll(localATCopy);
+            targets = accessTransformers.keySet().stream().map(Target::className).collect(Collectors.toSet());
+        }
+    }
+}
