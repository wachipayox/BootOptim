+package net.neoforged.accesstransformer.parser;
+
+import net.neoforged.accesstransformer.AccessTransformer;
+import net.neoforged.accesstransformer.AccessTransformerEngineImpl;
+import net.neoforged.accesstransformer.TargetType;
+import org.antlr.v4.runtime.CharStreams;
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassWriter;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.Type;
+import org.objectweb.asm.tree.ClassNode;
+import org.objectweb.asm.tree.FieldNode;
+
+import java.io.ByteArrayOutputStream;
+import java.io.PrintStream;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Set;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotSame;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * Diagnostic-only differential oracle. Each file is parsed exactly once by the exact 10.0.1
+ * parser and the resulting AccessTransformer/Target object graph is fed to both real
+ * AccessTransformerList instances. This is the identity-sharing property that an external
+ * reparse or post-hoc map reconstruction cannot provide for HashMap tree-bin tie breaking.
+ */
+class InProcessTopologyOracleTest {
+    @Test
+    void sharedParsedObjectsMatchEveryIterationSurfaceAcrossAaBbCorpus() {
+        var stock = new AccessTransformerList(false);
+        var candidate = new AccessTransformerList(true);
+        var classes = collidingNames(5);
+
+        for (int i = 0; i < classes.size(); i++) {
+            String className = "oracle." + classes.get(i);
+            String origin = "collision-" + i + ".cfg";
+            String text = "public-f " + className + "\n"
+                    + "protected " + className + " Aa\n"
+                    + "public " + className + " BB\n";
+
+            List<AccessTransformer> shared = AccessTransformerList.parseForOracle(CharStreams.fromString(text, origin));
+            stock.loadParsedForOracle(shared, origin);
+            candidate.loadParsedForOracle(shared, origin);
+            assertAllSurfaces(stock, candidate);
+        }
+    }
+
+    @Test
+    void conflictRollbackAndDiagnosticTraversalUseSameSharedIdentityTopology() {
+        var stock = new AccessTransformerList(false);
+        var candidate = new AccessTransformerList(true);
+
+        String baseOrigin = "base.cfg";
+        List<AccessTransformer> base = AccessTransformerList.parseForOracle(CharStreams.fromString(
+                "public+f oracle.Aa Aa\npublic+f oracle.BB BB\n", baseOrigin));
+        stock.loadParsedForOracle(base, baseOrigin);
+        candidate.loadParsedForOracle(base, baseOrigin);
+        assertAllSurfaces(stock, candidate);
+
+        String conflictOrigin = "conflict.cfg";
+        List<AccessTransformer> conflict = AccessTransformerList.parseForOracle(CharStreams.fromString(
+                "public-f oracle.Aa Aa\npublic-f oracle.BB BB\n", conflictOrigin));
+        List<String> stockDiagnosticOrder = stock.oracleInvalidOrder(conflict, conflictOrigin);
+        List<String> candidateDiagnosticOrder = candidate.oracleInvalidOrder(conflict, conflictOrigin);
+        assertFalse(stockDiagnosticOrder.isEmpty());
+        assertEquals(stockDiagnosticOrder, candidateDiagnosticOrder);
+
+        List<String> stockBefore = stock.oracleRawEntries();
+        List<String> candidateBefore = candidate.oracleRawEntries();
+        IllegalArgumentException stockFailure = assertThrows(IllegalArgumentException.class,
+                () -> stock.loadParsedForOracle(conflict, conflictOrigin));
+        IllegalArgumentException candidateFailure = assertThrows(IllegalArgumentException.class,
+                () -> candidate.loadParsedForOracle(conflict, conflictOrigin));
+        assertEquals(stockFailure.getMessage(), candidateFailure.getMessage());
+        assertEquals("Invalid AT final conflicts", stockFailure.getMessage());
+        assertEquals(stockBefore, stock.oracleRawEntries());
+        assertEquals(candidateBefore, candidate.oracleRawEntries());
+        assertAllSurfaces(stock, candidate);
+    }
+
+    @Test
+    void malformedParserFailureFingerprintIsUnchanged() {
+        Failure stock = captureMalformed(new AccessTransformerList(false));
+        Failure candidate = captureMalformed(new AccessTransformerList(true));
+        assertEquals(stock, candidate);
+        assertTrue(stock.stderr().contains("line 1:"), stock.stderr());
+    }
+
+    @Test
+    void escapedTargetSetMutabilityIdentityAndNextPublicationMatch() {
+        var stock = new AccessTransformerList(false);
+        var candidate = new AccessTransformerList(true);
+        Type mutation = Type.getObjectType("external/Mutation");
+
+        assertThrows(UnsupportedOperationException.class, () -> stock.getTargets().add(mutation));
+        assertThrows(UnsupportedOperationException.class, () -> candidate.getTargets().add(mutation));
+
+        loadShared(stock, candidate, "public oracle.Alpha\n", "one.cfg");
+        Set<Type> escapedStock = stock.getTargets();
+        Set<Type> escapedCandidate = candidate.getTargets();
+        assertEquals(new ArrayList<>(escapedStock), new ArrayList<>(escapedCandidate));
+        escapedStock.add(mutation);
+        escapedCandidate.add(mutation);
+        assertTrue(stock.getTargets().contains(mutation));
+        assertTrue(candidate.getTargets().contains(mutation));
+
+        loadShared(stock, candidate, "public oracle.Bravo\n", "two.cfg");
+        Set<Type> currentStock = stock.getTargets();
+        Set<Type> currentCandidate = candidate.getTargets();
+        assertNotSame(escapedStock, currentStock);
+        assertNotSame(escapedCandidate, currentCandidate);
+        assertTrue(escapedStock.contains(mutation));
+        assertTrue(escapedCandidate.contains(mutation));
+        assertFalse(currentStock.contains(mutation));
+        assertFalse(currentCandidate.contains(mutation));
+        assertEquals(new ArrayList<>(currentStock), new ArrayList<>(currentCandidate));
+    }
+
+    @Test
+    void actualEngineTransformsAreByteIdentical() {
+        var stock = new AccessTransformerList(false);
+        var candidate = new AccessTransformerList(true);
+        loadShared(stock, candidate,
+                "public-f oracle.Aa\nprotected oracle.Aa Aa\npublic oracle.Aa BB\n"
+                        + "public oracle.BB\nprotected oracle.BB Aa\npublic oracle.BB BB\n",
+                "transform.cfg");
+        assertAllSurfaces(stock, candidate);
+
+        var stockEngine = new AccessTransformerEngineImpl(stock);
+        var candidateEngine = new AccessTransformerEngineImpl(candidate);
+        for (Type type : stock.getTargets()) {
+            ClassNode stockNode = sampleClass(type);
+            ClassNode candidateNode = sampleClass(type);
+            assertEquals(stockEngine.transform(stockNode, type), candidateEngine.transform(candidateNode, type));
+            assertArrayEquals(classBytes(stockNode), classBytes(candidateNode));
+        }
+    }
+
+    private static void assertAllSurfaces(AccessTransformerList stock, AccessTransformerList candidate) {
+        assertEquals(stock.oracleRawEntries(), candidate.oracleRawEntries(), "raw committed HashMap iteration");
+        assertEquals(accessGroups(stock.getAccessTransformers()), accessGroups(candidate.getAccessTransformers()), "getAccessTransformers iteration");
+        assertEquals(new ArrayList<>(stock.getTargets()), new ArrayList<>(candidate.getTargets()), "getTargets iteration");
+        assertEquals(stock.getTargets(), candidate.getTargets(), "getTargets membership");
+        for (Type type : stock.getTargets()) {
+            assertEquals(targetGroups(stock.getTransformersForTarget(type)), targetGroups(candidate.getTransformersForTarget(type)),
+                    "getTransformersForTarget iteration for " + type);
+        }
+    }
+
+    private static List<String> accessGroups(Map<String, List<AccessTransformer>> groups) {
+        List<String> out = new ArrayList<>();
+        groups.forEach((name, ats) -> out.add(name + "=" + ats.stream().map(at -> at.getTarget().toString()).toList()));
+        return out;
+    }
+
+    private static List<String> targetGroups(Map<TargetType, Map<String, AccessTransformer>> groups) {
+        List<String> out = new ArrayList<>();
+        groups.forEach((type, ats) -> {
+            List<String> entries = new ArrayList<>();
+            ats.forEach((name, at) -> entries.add(name + "=" + at.getTarget()));
+            out.add(type + "=" + entries);
+        });
+        return out;
+    }
+
+    private static void loadShared(AccessTransformerList stock, AccessTransformerList candidate, String text, String origin) {
+        List<AccessTransformer> shared = AccessTransformerList.parseForOracle(CharStreams.fromString(text, origin));
+        stock.loadParsedForOracle(shared, origin);
+        candidate.loadParsedForOracle(shared, origin);
+    }
+
+    private static Failure captureMalformed(AccessTransformerList list) {
+        PrintStream old = System.err;
+        ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+        Throwable thrown;
+        try {
+            System.setErr(new PrintStream(bytes, true, StandardCharsets.UTF_8));
+            thrown = assertThrows(Throwable.class, () -> list.loadAT(CharStreams.fromString("public oracle.Bad broken(\n", "malformed.cfg")));
+        } finally {
+            System.setErr(old);
+        }
+        return new Failure(thrown.getClass().getName(), Objects.toString(thrown.getMessage(), "<null>"), bytes.toString(StandardCharsets.UTF_8));
+    }
+
+    private static ClassNode sampleClass(Type type) {
+        ClassNode node = new ClassNode();
+        node.version = Opcodes.V17;
+        node.access = Opcodes.ACC_PRIVATE;
+        node.name = type.getInternalName();
+        node.superName = "java/lang/Object";
+        node.fields.add(new FieldNode(Opcodes.ACC_PRIVATE | Opcodes.ACC_FINAL, "Aa", "I", null, null));
+        node.fields.add(new FieldNode(Opcodes.ACC_PRIVATE, "BB", "I", null, null));
+        return node;
+    }
+
+    private static byte[] classBytes(ClassNode node) {
+        ClassWriter writer = new ClassWriter(0);
+        node.accept(writer);
+        return writer.toByteArray();
+    }
+
+    private static List<String> collidingNames(int depth) {
+        List<String> names = List.of("");
+        for (int i = 0; i < depth; i++) {
+            List<String> next = new ArrayList<>();
+            for (String prefix : names) {
+                next.add(prefix + "Aa");
+                next.add(prefix + "BB");
+            }
+            names = next;
+        }
+        return names;
+    }
+
+    private record Failure(String throwableClass, String message, String stderr) {}
+}
